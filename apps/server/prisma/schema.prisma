generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户权限域 ============

model AdminUser {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  nickname    String
  avatar      String?
  status      Int       @default(1)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  roles AdminUserRole[]

  @@map("admin_user")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?
  status      Int     @default(1)
  sort        Int     @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id        Int     @id @default(autoincrement())
  parentId  Int?    @map("parent_id")
  type      Int
  name      String
  code      String  @unique
  path      String?
  icon      String?
  sort      Int     @default(0)
  status    Int     @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[]     @relation("PermissionTree")
  roles    RolePermission[]

  @@map("permission")
}

model AdminUserRole {
  id          Int @id @default(autoincrement())
  adminUserId Int @map("admin_user_id")
  roleId      Int @map("role_id")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, roleId])
  @@map("admin_user_role")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id          Int       @id @default(autoincrement())
  phone       String    @unique
  password    String
  nickname    String
  avatar      String?
  gender      Int       @default(0)
  status      Int       @default(1)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  addresses UserAddress[]
  carts     Cart[]
  orders    Order[]

  @@map("user")
}

model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  receiverName  String   @map("receiver_name")
  receiverPhone String   @map("receiver_phone")
  province      String
  city          String
  district      String
  detail        String
  isDefault     Int      @default(0) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_address")
}

// ============ 商品域 ============

model Category {
  id        Int       @id @default(autoincrement())
  parentId  Int?      @map("parent_id")
  name      String
  level     Int       @default(1)
  sort      Int       @default(0)
  status    Int       @default(1)
  icon      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]  @relation("CategoryTree")
  products Product[]

  @@map("category")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  logo      String?
  sort      Int       @default(0)
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("brand")
}

model Product {
  id         Int       @id @default(autoincrement())
  name       String
  subTitle   String?   @map("sub_title")
  categoryId Int       @map("category_id")
  brandId    Int       @map("brand_id")
  mainImage  String    @map("main_image")
  detail     String?
  status     Int       @default(1)
  sort       Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  category   Category           @relation(fields: [categoryId], references: [id])
  brand      Brand              @relation(fields: [brandId], references: [id])
  specGroups ProductSpecGroup[]
  skus       ProductSku[]
  images     ProductImage[]

  @@map("product")
}

model ProductSpecGroup {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductSpecValue[]

  @@map("product_spec_group")
}

model ProductSpecValue {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  value     String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group    ProductSpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  skuLinks SkuSpecValue[]

  @@map("product_spec_value")
}

model ProductSku {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  price         Int
  originalPrice Int?     @map("original_price")
  stock         Int      @default(0)
  skuCode       String?  @map("sku_code")
  image         String?
  status        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  specValues SkuSpecValue[]
  carts      Cart[]
  orderItems OrderItem[]

  @@map("product_sku")
}

model SkuSpecValue {
  id          Int @id @default(autoincrement())
  skuId       Int @map("sku_id")
  specValueId Int @map("spec_value_id")

  sku       ProductSku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  specValue ProductSpecValue @relation(fields: [specValueId], references: [id], onDelete: Cascade)

  @@unique([skuId, specValueId])
  @@map("sku_spec_value")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

// ============ 交易域 ============

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  skuId     Int      @map("sku_id")
  quantity  Int      @default(1)
  selected  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku  ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([userId, skuId])
  @@map("cart")
}

model Order {
  id               Int       @id @default(autoincrement())
  orderNo          String    @unique @map("order_no")
  userId           Int       @map("user_id")
  totalAmount      Int       @map("total_amount")
  freightAmount    Int       @default(0) @map("freight_amount")
  payAmount        Int       @map("pay_amount")
  status           Int       @default(10)
  receiverName     String    @map("receiver_name")
  receiverPhone    String    @map("receiver_phone")
  receiverAddress  String    @map("receiver_address")
  remark           String?
  logisticsCompany String?   @map("logistics_company")
  logisticsNo      String?   @map("logistics_no")
  paidAt           DateTime? @map("paid_at")
  shippedAt        DateTime? @map("shipped_at")
  completedAt      DateTime? @map("completed_at")
  canceledAt       DateTime? @map("canceled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  skuId        Int      @map("sku_id")
  productId    Int      @map("product_id")
  productName  String   @map("product_name")
  skuSpec      String   @map("sku_spec")
  productImage String?  @map("product_image")
  price        Int
  quantity     Int
  totalAmount  Int      @map("total_amount")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   ProductSku @relation(fields: [skuId], references: [id])

  @@map("order_items")
}

model Payment {
  id            Int       @id @default(autoincrement())
  paymentNo     String    @unique @map("payment_no")
  orderId       Int       @map("order_id")
  userId        Int       @map("user_id")
  amount        Int
  channel       Int
  status        Int       @default(1)
  transactionId String?   @map("transaction_id")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment")
}

# ===== 客服服务 =====
PORT=3002

# ===== DeepSeek（LLM）=====
DEEPSEEK_API_KEY=***

# ===== 硅基流动（embedding BAAI/bge-large-zh-v1.5 + reranker BAAI/bge-reranker-v2-m3）=====
SILICONFLOW_API_KEY=***

# ===== 数据库（复用 mall 的 PostgreSQL + pgvector）=====
DATABASE_URL="postgresql://mall:mall123@localhost:5432/mall?schema=customer_service"

# ===== 用户 JWT（复用 mall-server 签发的用户 accessToken，需与 server 的 JWT_ACCESS_SECRET 一致）=====
JWT_ACCESS_SECRET=change-me-access-secret

# ===== mall-server（客服服务调它的 HTTP 接口）=====
MALL_SERVER_URL=http://localhost:3000/api

# ===== Langfuse 观测（本地自托管）=====
LANGFUSE_PUBLIC_KEY=***
LANGFUSE_SECRET_KEY=***
LANGFUSE_BASEURL=http://localhost:3003

# ===== Langfuse headless 初始化（docker compose 自动建 key）=====
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=***
LANGFUSE_INIT_PROJECT_SECRET_KEY=***
LANGFUSE_INIT_USER_EMAIL=dev@local.dev
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=***

# ===== 客服服务 =====
PORT=3002

# ===== DeepSeek（LLM）=====
DEEPSEEK_API_KEY=***

# ===== 硅基流动（embedding BAAI/bge-large-zh-v1.5 + reranker BAAI/bge-reranker-v2-m3）=====
SILICONFLOW_API_KEY=***

# ===== 数据库（复用 mall 的 PostgreSQL + pgvector）=====
DATABASE_URL="postgresql://mall:mall123@localhost:5432/mall?schema=customer_service"

# ===== 用户 JWT（复用 mall-server 签发的用户 accessToken，需与 server 的 JWT_ACCESS_SECRET 一致）=====
JWT_ACCESS_SECRET=change-me-access-secret

# ===== mall-server（客服服务调它的 HTTP 接口）=====
MALL_SERVER_URL=http://localhost:3000/api

# ===== Langfuse 观测（本地自托管）=====
LANGFUSE_PUBLIC_KEY=***
LANGFUSE_SECRET_KEY=***
LANGFUSE_BASEURL=http://localhost:3003

# ===== Langfuse headless 初始化（docker compose 自动建 key）=====
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=***
LANGFUSE_INIT_PROJECT_SECRET_KEY=***
LANGFUSE_INIT_USER_EMAIL=dev@local.dev
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=***

# ===== CORS（生产用逗号分隔的域名白名单；不填则放开，仅建议本地开发）=====
# CORS_ORIGINS=https://your-domain.example

# ===== 成本护栏（均为可选，下面是默认值）=====
# DAILY_REQUEST_LIMIT=300
# DAILY_TOKEN_LIMIT=300000
# CHAT_MAX_OUTPUT_TOKENS=1500
# CHAT_TIMEOUT_MS=120000

# ===== 语义缓存 =====
# QA_CACHE_SIMILARITY_THRESHOLD=0.85
# QA_CACHE_TTL_DAYS=30
# QA_CACHE_MAX_QUESTION_LENGTH=200
# QA_CACHE_MAX_ANSWER_LENGTH=2000

# ===== RAG 相关度阈值（false positive 太多就调高）=====
# RAG_MIN_RERANK_SCORE=0.3
# RAG_MIN_COSINE_SIMILARITY=0.55

# ===== db_query 安全边界 =====
# DB_QUERY_MAX_ROWS=50
# DB_QUERY_TIMEOUT_MS=3000
# DB_QUERY_MAX_SQL_LENGTH=4000

# ===== 上下文压缩 =====
# CONTEXT_TOKEN_BUDGET=40000
# CONTEXT_KEEP_MIN_WINDOW=4
# CONTEXT_COMPRESS_TIMEOUT_MS=15000

# ===== 用户画像 =====
# USER_PROFILE_MAX_FACTS=20
# USER_PROFILE_CONSOLIDATE_TO=12
# USER_PROFILE_CONSOLIDATE_TIMEOUT_MS=15000

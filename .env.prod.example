# ===== 复制为 .env.prod 并修改，勿提交真实密钥 =====
# 运行：export IMAGE_TAG=<gitSHA前7位> && docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ===== 镜像仓库（CI 构建产物地址）=====
# REGISTRY = ACR 地址 + 命名空间；IMAGE_TAG = 本次发布的 git SHA 前7位（CI 自动注入，勿用 latest）
REGISTRY=registry.cn-hangzhou.aliyuncs.com/mall
IMAGE_TAG=latest

# ===== Database (PostgreSQL) =====
# 容器内通过服务名 db 访问；账号密码需与下方 POSTGRES_* 一致
DATABASE_URL="postgresql://mall:mall123@db:5432/mall?schema=public"
POSTGRES_USER=mall
POSTGRES_PASSWORD=mall123
POSTGRES_DB=mall

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== MinIO (S3-compatible object storage) =====
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mall
MINIO_USE_SSL=false
# 浏览器可达的公网地址（换 OSS/CDN 时改这里即可，DB 只存 key 不受影响）
MINIO_PUBLIC_URL=http://<your-ecs-ip>:9000

# ===== JWT（生产务必换成强随机值）=====
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=604800

# ===== App =====
PORT=3000
